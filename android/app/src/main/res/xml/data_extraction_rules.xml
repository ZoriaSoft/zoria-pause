<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ data-extraction katmanı: allowBackup=false ile birlikte hiçbir
     veri cloud-backup veya device-transfer'a çıkmaz (fleet review
     2026-09-21). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
