<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ data-extraction katmanı: allowBackup=false ile birlikte hiçbir
     veri cloud-backup veya device-transfer'a çıkmaz (fleet review
     2026-09-21). Drift DB (zoria_pause.sqlite ve -wal/-shm/-journal yan
     dosyaları, hostname geçmişi) de dışarıda: drift_flutter varsayılan olarak
     getApplicationDocumentsDirectory() altına yazar; path_provider_android
     bunu PathUtils.getDataDirectory (getDir("flutter") = app_flutter/, yani
     backup "root" domain'i) olarak çözer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite" />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite-wal" />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite-shm" />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite" />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite-wal" />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite-shm" />
        <exclude domain="root" path="app_flutter/zoria_pause.sqlite-journal" />
    </device-transfer>
</data-extraction-rules>
